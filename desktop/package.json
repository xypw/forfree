{
  "name": "forfree",
  "version": "1.0.0",
  "description": "ForFree 办公套件 —— 离线可用的桌面版办公工具",
  "main": "main.js",
  "author": "ForFree",
  "license": "MIT",
  "private": true,
  "scripts": {
    "sync": "node sync-web.js",
    "start": "npm run sync && electron .",
    "self-test": "npm run sync && electron . --self-test",
    "icon": "python tools/make-icon.py",
    "dist:dir": "electron-builder --win dir --x64",
    "dist:portable": "electron-builder --win portable --x64 --prepackaged dist/win-unpacked",
    "dist": "npm run sync && npm run dist:dir && node tools/apply-icon.js && npm run dist:portable"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.forfree.desktop",
    "productName": "ForFree",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "build/icon.png", "web/**/*", "package.json"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ForFree-${version}-portable.exe",
      "unicode": true
    },
    "compression": "maximum"
  },
  "comment": "signAndEditExecutable=false 是为了绕开 winCodeSign 解压需要管理员权限的问题。app exe 的图标与版本信息由 tools/apply-icon.js 在 --dir 之后、--prepackaged 之前用 rcedit 补上（NSIS 自解压包不能用 rcedit，会写坏）。"
}
